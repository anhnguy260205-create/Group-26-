# LLM configuration for the burnout-reasoning and closing-reflection text.
# Everything works with NONE of these set — the app falls back to templated text
# and never depends on the LLM being reachable.

# --- Primary: Microsoft Foundry -----------------------------------------------
# Your Foundry / Azure AI resource endpoint. Either the resource base, e.g.
#   https://<your-resource>.services.ai.azure.com
# or a full chat-completions URL (used as-is if it already contains chat/completions).
AZURE_AI_ENDPOINT=
# API key from the Foundry resource.
AZURE_AI_API_KEY=
# Model / deployment for the "deep" tier — reasoning-heavy calls such as the capacity
# forecast, outlook and capacity scoring (default: claude-sonnet-4-5).
# Examples: claude-sonnet-4-5, gpt-4o, phi-4.
AZURE_AI_MODEL=claude-sonnet-4-5
# Model / deployment for the "fast" tier — short interactive text where latency matters
# more than depth (companion opening line, breathing guidance, threshold explanation).
# Both tiers hit the SAME endpoint and key; only the model name changes, so this is model
# routing without a second integration. Optional: falls back to AZURE_AI_MODEL if unset,
# so a resource with a single deployment keeps working.
AZURE_AI_MODEL_FAST=claude-haiku-4-5
# Only needed for classic Azure OpenAI deployment endpoints, e.g. 2024-10-21.
# Leave blank when using the newer /openai/v1 surface.
AZURE_AI_API_VERSION=

# --- Fallback: Anthropic direct -----------------------------------------------
# Used only if the Foundry vars above are not set. Lets the app run without Azure.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
